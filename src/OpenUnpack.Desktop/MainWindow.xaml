<Window x:Class="OpenUnpack.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenUnpack · 批量解压与密码库" Width="1340" Height="900" MinWidth="1050" MinHeight="740" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#14233D">
            <Grid Margin="20,30,20,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="OpenUnpack" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="解压文件，整理密码" Foreground="#91A5C5" Margin="0,9,0,33"/></StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="BatchNav" Content="01   批量解压" Click="BatchNav_Click" HorizontalContentAlignment="Left" Background="#2B4470" Foreground="White" BorderThickness="0" Margin="0,0,0,9" Padding="16,13"/>
                    <Button x:Name="VaultNav" Content="02   密码库" Click="VaultNav_Click" Background="Transparent" Foreground="#C1CEE3" BorderThickness="0" Margin="0,0,0,9" Padding="16,13"/>
                    <Button x:Name="HistoryNav" Content="03   处理记录" Click="HistoryNav_Click" Background="Transparent" Foreground="#C1CEE3" BorderThickness="0" Margin="0,0,0,9" Padding="16,13"/>
                    <Button x:Name="SettingsNav" Content="04   设置与说明" Click="SettingsNav_Click" Background="Transparent" Foreground="#C1CEE3" BorderThickness="0" Margin="0,0,0,9" Padding="16,13"/>
                </StackPanel>
                <StackPanel Grid.Row="3"><Border Background="#203554" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="本地优先 · 开源" Foreground="#E2EBFA" FontWeight="SemiBold"/><TextBlock Text="密码留在这台电脑&#10;原始压缩包始终保留" Foreground="#91A5C5" LineHeight="21" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="预览版 0.1.0" Foreground="#91A5C5" Margin="1,18,0,0" FontSize="11"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,23"><StackPanel><TextBlock x:Name="PageTitle" Text="批量解压" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="把压缩包或文件夹拖进来，其余交给队列。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8EFFD" CornerRadius="15" Padding="12,7"><TextBlock x:Name="EngineStatus" Text="正在检查引擎" Foreground="#245BE8" FontSize="12"/></Border></Grid>
            <Border x:Name="AlertBanner" Grid.Row="1" Background="#FFF3DB" CornerRadius="8" Padding="14,11" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="AlertText" Foreground="#815210" TextWrapping="Wrap"/></Border>
            <Grid Grid.Row="2">
                <Grid x:Name="BatchPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,17"><StackPanel Orientation="Horizontal"><Button x:Name="AddFilesButton" Content="＋ 添加压缩包" Click="AddFiles_Click"/><Button x:Name="AddFolderButton" Content="添加文件夹" Click="AddFolder_Click"/><Button x:Name="RetryButton" Content="重试未完成" Click="Retry_Click"/><Button x:Name="ClearButton" Content="清空已完成" Click="Clear_Click"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False"/><Button x:Name="StartButton" Content="开始解压" Click="Start_Click" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel></Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid><DataGrid x:Name="QueueGrid" ItemsSource="{Binding Jobs}" SelectionChanged="QueueGrid_SelectionChanged"><DataGrid.Columns><DataGridTemplateColumn Header="压缩包" Width="*" MinWidth="235"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceDirectory}" Foreground="#8A96AA" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100"/><DataGridTemplateColumn Header="进度" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Foreground="#245BE8" Background="#E9EDF5" BorderThickness="0"/><TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#63738C" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="处理信息" Binding="{Binding Message}" Width="2*" MinWidth="180"/></DataGrid.Columns></DataGrid><StackPanel x:Name="QueueEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="68" Height="68" Background="#EDF2FD" CornerRadius="19" HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="37" Foreground="#245BE8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="将压缩包拖到这里" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="也可以添加整个文件夹 · 自动识别分卷并去重" Foreground="#63738C"/></StackPanel></Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel x:Name="OutputControls"><TextBlock Text="输出与密码" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputPathBox" ToolTip="留空时，每个压缩包解压到原文件所在文件夹"/><Button Grid.Column="1" Content="浏览" Click="OutputBrowse_Click" Margin="8,0,0,0"/></Grid><TextBlock Text="留空：在压缩包旁创建独立文件夹" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="同名目录" Foreground="#63738C" Margin="0,0,0,6"/><ComboBox x:Name="ConflictBox" SelectedIndex="0"><ComboBoxItem Content="自动重命名目录"/><ComboBoxItem Content="跳过已存在目录"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="使用密码分组" Foreground="#63738C" Margin="0,0,0,6"/><ComboBox x:Name="RunGroupBox"/></StackPanel></Grid><CheckBox x:Name="RecursiveBox" Content="添加文件夹时包含子文件夹" IsChecked="True" Margin="0,13,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel x:Name="CacheControls"><DockPanel><TextBlock Text="SSD 缓存" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="可选" Foreground="#63738C" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="适合机械硬盘来源；在 SSD 暂存解压内容，完成后清理。" Style="{StaticResource Caption}" FontSize="12" Margin="0,9,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CachePathBox" ToolTip="留空即关闭缓存；请选择 SSD 上的文件夹"/><Button Grid.Column="1" Content="浏览" Click="CacheBrowse_Click" Margin="8,0,0,0"/></Grid><TextBlock Text="留空：关闭缓存。请自行选择 SSD 上的文件夹。" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="CacheInputBox" Content="先将压缩包及分卷复制到缓存" IsChecked="True" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="CacheSizeBox" Text="20" Width="58"/><TextBlock Text="GB 上限" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#63738C"/></StackPanel></Grid></StackPanel></Border>
                    </Grid>
                </Grid>
                <Grid x:Name="VaultPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="VaultActions" Orientation="Horizontal" Margin="0,0,0,17"><Button Content="＋ 新增密码" Click="AddPassword_Click" Style="{StaticResource PrimaryButton}"/><Button Content="编辑" Click="EditPassword_Click"/><Button Content="删除" Click="DeletePassword_Click"/><Button Content="导入 TXT / TSV" Click="ImportPasswords_Click"/><Button Content="加密备份" Click="Backup_Click"/><Button Content="恢复备份" Click="Restore_Click"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBox x:Name="PasswordSearch" TextChanged="PasswordSearch_Changed" ToolTip="搜索名称、分组或备注"/><ComboBox x:Name="VaultGroupBox" Grid.Column="2" SelectionChanged="VaultGroup_Changed"/></Grid><Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="PasswordGrid" ItemsSource="{Binding Passwords}" MouseDoubleClick="PasswordGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="140"/><DataGridTextColumn Header="密码" Binding="{Binding MaskedSecret}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding EnabledText}" Width="85"/><DataGridTextColumn Header="成功次数" Binding="{Binding SuccessCount}" Width="90"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="2*"/></DataGrid.Columns></DataGrid></Border></Grid>
                <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><TextBlock Text="最近 500 条本地处理记录，不记录密码内容。" Style="{StaticResource Caption}"/><Button Content="打开选中输出目录" HorizontalAlignment="Right" Click="OpenHistoryOutput_Click" Margin="0"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}"><DataGrid.Columns><DataGridTextColumn Header="压缩包" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="结果" Binding="{Binding StatusText}" Width="95"/><DataGridTextColumn Header="完成时间" Binding="{Binding FinishedLocal}" Width="155"/><DataGridTextColumn Header="处理信息" Binding="{Binding Message}" Width="2*"/></DataGrid.Columns></DataGrid></Border></Grid>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="本地密码库" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="密码库使用 Windows 用户保护加密。只有当前 Windows 用户可以正常读取；迁移到另一台电脑请使用“加密备份”。" Style="{StaticResource Caption}" Margin="0,10,0,12"/><TextBlock x:Name="DataDirectoryText" TextWrapping="Wrap" Foreground="#245BE8"/><Button Content="打开数据目录" Click="OpenDataDirectory_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="SSD 缓存如何工作" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. 在批量解压页选择 SSD 上的缓存文件夹。&#10;2. 可先复制机械硬盘上的压缩包及全部分卷，降低原盘反复读取。&#10;3. 解压结果在缓存中暂存，通过校验后写回输出目录。&#10;4. 成功、失败或取消后清理本次暂存内容，原始压缩包保留。" Style="{StaticResource Caption}" Margin="0,10,0,8"/><TextBlock Text="缓存空间上限为 1–1024 GB，默认 20 GB。速度收益取决于源盘、目标盘、文件数量与解压算法；CPU 密集型任务可能变化不明显。" Style="{StaticResource Caption}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="安全与兼容性" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="使用 7-Zip 原生引擎；将发行包内的 7z.dll 放在应用程序旁。&#10;压缩包解压到独立目录；拒绝越界路径与链接，失败或密码不匹配不会发布部分结果。&#10;密码轮试仅使用你主动加入并启用的条目。处理期间暂停密码库与队列编辑。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="FooterText" Text="队列为空 · 本地处理，原文件保留" Foreground="#63738C" FontSize="12"/><Button x:Name="OpenOutputButton" Content="打开选中输出" Click="OpenOutput_Click" HorizontalAlignment="Right" Padding="9,5" Margin="0" Visibility="Collapsed"/></Grid>
        </Grid>
    </Grid>
</Window>
