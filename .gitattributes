# Byte-exact assets. Release material collection verifies these files by
# SHA-256, so checkout must not rewrite line endings.
assets/legal/** -text
crates/local-api/assets/** -text
# Upstream archive fixtures are verified byte-for-byte against provenance.json.
tests/fixtures/** -text

# Normalize sources checked by formatting and lint gates.
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.ps1 text eol=crlf
