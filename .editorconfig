# 根级 EditorConfig：全仓库统一编辑器基线。
# C# worker 已随纯 Rust 微内核迁移退役，原 Roslyn SAST 规则一并移除。
root = true

[*]
charset = utf-8
# 仓库启用 core.autocrlf=true：工作树保持 CRLF，入库由 git 归一为 LF。
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Rust：与 rustfmt.toml 保持一致
[*.rs]
indent_style = space
indent_size = 4

# 前端与脚本类：与 .prettierrc 保持一致
[*.{ts,tsx,js,mjs,cjs,jsx,json,jsonc,yml,yaml,toml}]
indent_style = space
indent_size = 2

# PowerShell 脚本
[*.ps1]
indent_style = space
indent_size = 4

# Markdown：行尾双空格有语义（硬换行），不做修剪
[*.md]
trim_trailing_whitespace = false
